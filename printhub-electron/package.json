{
  "name": "printhub-desktop",
  "version": "1.0.7",
  "description": "Printhub Shop Desktop App — Manual print operator console",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "generate:icons": "node scripts/generate-icons.js",
    "prebuild": "node scripts/generate-icons.js && node scripts/postinstall-patches.js",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "electron": "^30.0.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.printhub.desktop",
    "productName": "Printhub",
    "copyright": "© 2025 Printhub",
    "asar": true,
    "icon": "assets/icon.ico",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Printhub",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "allowElevation": true,
      "perMachine": false
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/icon.png",
      ".env",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraFiles": [],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": null
  }
}
